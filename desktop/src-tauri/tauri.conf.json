{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Modwen",
  "version": "0.4.1",
  "identifier": "org.rtima.modwen",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../engine/": "engine/",
      "../bin/": "bin/"
    },
    "category": "Productivity",
    "shortDescription": "Local-first meeting notes for Arabic and English",
    "copyright": "Apache-2.0",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist",
      "entitlements": null,
      "signingIdentity": null
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Arabic"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyOTNDMERGQkI1ODU3ODgKUldTSVYxaTczOENUQWc1aWFTUjUxUWVCcE5VQitHVVBSYmRwL2tpUzF6TnZCM3hWdUVSa1RVUjcK",
      "endpoints": [
        "https://github.com/AbdullhRtima/modwen/releases/latest/download/latest.json"
      ]
    }
  }
}
